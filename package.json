{
  "name": "agent-hands",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "description": "Agent workspace layouts and repository navigation.",
  "author": "Velklish (https://github.com/Velklish)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Velklish/agent-hands.git"
  },
  "homepage": "https://github.com/Velklish/agent-hands#readme",
  "bugs": "https://github.com/Velklish/agent-hands/issues",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "backslop": "https://codeload.github.com/Velklish/backslop/tar.gz/refs/tags/v1.0.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run typecheck && npm run test:layout:types && npm run test:public",
    "check:dist": "node scripts/check-dist.mjs",
    "test:public": "node --test \"test/**/*.test.mjs\" && npm run test:voice",
    "test:mutations": "node test/git/mutation-probes.mjs && node test/hooks/mutation-probes.mjs",
    "test:layout": "npm run build && npm run test:layout:types && node --test test/*.test.mjs test/adapters/*/*.test.mjs",
    "test:layout:types": "tsc --ignoreConfig --noEmit --strict --module NodeNext test/contract.mts",
    "test:voice": "python3 -B -m unittest discover -s profiles/my-voice/tests",
    "test:hooks": "npm run build && npm run test:layout:types && node --test test/hooks/*.test.mjs test/adapters/*/hooks.test.mjs test/adapters/claude/preference-release.test.mjs test/adapters/claude/registration.test.mjs && node test/hooks/mutation-probes.mjs",
    "test:all": "backslop gates",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "@types/node": "26.6.6",
    "smol-toml": "1.9.0"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "profiles/my-voice/README.md",
    "profiles/my-voice/skills/**/*.md",
    "profiles/my-voice/skills/**/*.py",
    "docs/reference/*.md",
    "examples/hooks.mjs"
  ],
  "version": "0.1.0",
  "bin": {
    "agent-hands": "bin/agent-hands.js"
  }
}
